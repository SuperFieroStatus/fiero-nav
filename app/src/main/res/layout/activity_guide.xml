<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:keepScreenOn="true"
    android:orientation="vertical">

    <!-- Arrival time · time left · distance left -->
    <TextView
        android:id="@+id/eta"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:background="@color/strip_bg"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/guide"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <dev.mike.fieronav.ui.TurnArrowView
                android:id="@+id/arrow"
                android:layout_width="84dp"
                android:layout_height="84dp" />

            <TextView
                android:id="@+id/dist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="34sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/then"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/highlight"
            android:textSize="15sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/road"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Upcoming turns (Down from the guidance view) -->
    <dev.mike.fieronav.ui.ListScreen
        android:id="@+id/steps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <include layout="@layout/soft_keys" />
</LinearLayout>
